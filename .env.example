# Server Configuration
PORT=3000
HOST=127.0.0.1

# Browser Automation & Stealth Settings (Camoufox Gecko Engine)
# Persistent user data directory to store cookies, sessions, and credentials
USER_DATA_DIR=./user-data-camoufox
# Headless mode: 'true' or 'false'
HEADLESS=true
# RAM Optimization: Low-memory single-process Firefox profile, 16MB cache cap, zero-bfcache
OPTIMIZE_RAM=true
# Optional: Set to 'true' to block image requests for ultra-low RAM usage (defaults to true if OPTIMIZE_RAM is true)
BLOCK_IMAGES=true

# Token-Based Authentication Injection (Bypasses Google OAuth anti-bot in headless mode)
# Paste your extracted JWT token from DevTools -> Application -> Local Storage -> "token"
ZAI_AUTH_TOKEN=

# Model, Congestion & Completion Defaults
DEFAULT_MODEL=glm-5.3-flash
FALLBACK_MODEL=glm-5.3-flash
TIMEOUT_MS=120000
# Peak-hour abort threshold in ms when waiting for first token on non-flash models
PEAK_HOUR_TTFT_MS=9000
# Whether to include thinking/reasoning process in streaming delta (as reasoning_content)
STREAM_REASONING=true
